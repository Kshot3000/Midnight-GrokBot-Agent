# --- Required for deploy / wallet scripts (set EXACTLY one of seed OR mnemonic) ---
# MIDNIGHT_WALLET_MNEMONIC="word1 word2 ... word24"
# MIDNIGHT_WALLET_SEED=  # 32–128 hex chars; Lace BIP-39 seed is 128 hex chars

# --- Official Preprod endpoints (defaults match docs; override only if needed) ---
# MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_FAUCET_URL=https://midnight-tmnight-preprod.nethermind.dev/

# --- Private state store password (≥16 chars, 3 of 4 character classes) ---
# PRIVATE_STATE_PASSWORD=Change-Me-Preprod-Lab-1

# --- Explicit submit gate (deploy-preprod.mjs refuses without this) ---
# MIDNIGHT_PREPROD_ALLOW_SUBMIT=0

# --- Optional: faucet captcha token if automating /drips (browser faucet is normal path) ---
# MIDNIGHT_FAUCET_CAPTCHA_TOKEN=
