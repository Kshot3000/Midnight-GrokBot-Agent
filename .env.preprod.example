# Midnight Preprod — copy to .env.preprod (gitignored). NEVER commit secrets.
# Docs: https://docs.midnight.network/guides/networks-and-environments
# Funding: https://docs.midnight.network/guides/acquire-tokens
#
# Brand: donate addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
# X: @kshot9000

# --- Required for deploy / wallet scripts (set EXACTLY one of seed OR mnemonic) ---
# MIDNIGHT_WALLET_MNEMONIC="word1 word2 ... word24"
# MIDNIGHT_WALLET_SEED=  # 32–128 hex chars; Lace BIP-39 seed is 128 hex chars

# --- Preprod public endpoints (Blockfrost; hosted indexer/RPC shut down from 22:00 UTC 9 Oct 2026) ---
# Docs: https://docs.midnight.network/guides/networks-and-environments
# Upstream: https://github.com/midnightntwrk/midnight-docs/issues/1504
# BLOCKFROST_PROJECT_ID=   # Midnight Preprod project id, starts with nightpreprod. Never commit a real token.
# MIDNIGHT_INDEXER_URL=https://midnight-preprod.blockfrost.io/api/v0
# MIDNIGHT_INDEXER_WS_URL=wss://midnight-preprod.blockfrost.io/api/v0/ws
# MIDNIGHT_NODE_URL=https://rpc.midnight-preprod.blockfrost.io
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_FAUCET_URL=https://midnight-tmnight-preprod.nethermind.dev/

# --- Private state store password (≥16 chars, 3 of 4 character classes) ---
# PRIVATE_STATE_PASSWORD=Change-Me-Preprod-Lab-1

# --- Explicit submit gate (deploy-preprod.mjs refuses without this) ---
# MIDNIGHT_PREPROD_ALLOW_SUBMIT=0

# --- Optional: faucet captcha token if automating /drips (browser faucet is normal path) ---
# MIDNIGHT_FAUCET_CAPTCHA_TOKEN=

