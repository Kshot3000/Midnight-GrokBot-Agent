/*
 * agent-escrow.compact — Agent Escrow Compact skeleton
 *
 * Milestone-based escrow for AI-agent work on Midnight.
 * Ported from the JS/Python reference protocol in:
 *   https://github.com/Kshot3000/Cardano-Midnight-Qwen-Builder/tree/main/apps/agent-escrow
 *
 * Patterns aligned with official example-bboard / create-mn-app (bboard) and
 * the leaderboard tutorial:
 *   - pragma language_version >= 0.23
 *   - witness localSecretKey + persistentHash role commitments (NOT ownPublicKey)
 *   - disclose() on every ledger write
 *
 * MPS-0029: Never authorize with ownPublicKey() alone. ownPublicKey() is a
 * caller-supplied identifier, not a proof of key ownership. Authorization
 * here uses witness-derived commitments:
 *   roleCommitment(sk, roleTag) = persistentHash("agent-escrow:role:" || tag || sk)
 *
 * THIS IS AN EDUCATIONAL SKELETON. Lab-compiled with Compact 0.31.1 / lang 0.23
 * (2026-09-26 CT); managed artifacts are gitignored. NOT deployed on-chain.
 * Recompile with Compact ~0.31.1 (see README) before any deploy.
 * Resubmit-after-reject, dispute-resume restore, fund/addMilestone budget
 * asserts, and blockTimeLt deadline gates are source-only until the next
 * local compile. LOCAL-TRUE.
 *
 * Official docs:
 *   https://docs.midnight.network/compact
 *   https://docs.midnight.network/examples/dapps/bboard
 *   https://docs.midnight.network/tutorials/leaderboard/smart-contract
 *   https://docs.midnight.network/develop/reference/compact/ledger-adt
 *   https://docs.midnight.network/guides/security-best-practices
 *   https://github.com/midnightntwrk/example-bboard
 *   https://github.com/midnightntwrk/create-mn-app
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

/* ---------- enums / structs ---------- */

export enum EscrowState {
  CREATED,
  FUNDED,
  IN_PROGRESS,
  DISPUTED,
  SETTLED,
  REFUNDED,
  CANCELLED
}

export enum MilestoneStatus {
  PENDING,
  PROOF_SUBMITTED,
  RELEASED,
  REJECTED
}

struct Milestone {
  amount: Uint<64>,
  status: MilestoneStatus,
  proofHash: Bytes<32>,
  deadline: Uint<64>
}

/* ---------- public ledger ---------- */

export ledger state: EscrowState;

/* State to restore on resolveDisputeResume (FUNDED or IN_PROGRESS). */
export ledger stateBeforeDispute: EscrowState;

/* Role commitments (domain-separated hashes of private secrets). NOT raw public keys. */
export ledger clientPk: Bytes<32>;
export ledger agentPk: Bytes<32>;
export ledger approverPk: Bytes<32>;

export ledger funded: Uint<64>;
export ledger released: Uint<64>;
export ledger refunded: Uint<64>;

/* Freshness / deployment nonce (bboard-style sequence). */
export ledger sequence: Counter;

export ledger milestones: Map<Uint<64>, Milestone>;
export ledger milestoneCount: Counter;
export ledger decidedCount: Counter;
export ledger milestoneTotal: Uint<64>;

/* ---------- private witnesses (host-supplied; never on-chain) ---------- */

witness localSecretKey(): Bytes<32>;

/* ---------- constructor ---------- */

constructor() {
  state = EscrowState.CREATED;
  stateBeforeDispute = EscrowState.CREATED;
  clientPk = pad(32, "");
  agentPk = pad(32, "");
  approverPk = pad(32, "");
  funded = 0;
  released = 0;
  refunded = 0;
  milestoneTotal = 0;
  sequence.increment(1);
}

/* ---------- auth helpers (MPS-0029 compliant) ---------- */

/**
 * Derive a role commitment from a local secret + role tag.
 * Domain separator prevents cross-protocol hash reuse.
 */
export circuit roleCommitment(sk: Bytes<32>, roleTag: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "agent-escrow:role:"),
    roleTag,
    sk
  ]);
}

export circuit clientTag(): Bytes<32> {
  return pad(32, "client");
}

export circuit agentTag(): Bytes<32> {
  return pad(32, "agent");
}

export circuit approverTag(): Bytes<32> {
  return pad(32, "approver");
}

/**
 * Prove caller holds the secret that hashes to the registered client commitment.
 * Do NOT replace this with assert(ownPublicKey() == clientPk).
 */
circuit assertIsClient(): [] {
  assert(
    clientPk == roleCommitment(localSecretKey(), clientTag()),
    "not the registered client (witness secret must match client commitment)"
  );
}

circuit assertIsAgent(): [] {
  assert(
    agentPk == roleCommitment(localSecretKey(), agentTag()),
    "not the registered agent (witness secret must match agent commitment)"
  );
}

/**
 * Approver = registered approver OR client. Agent is excluded by construction:
 * initialize() requires agentPk to differ from clientPk and approverPk.
 */
circuit assertIsApprover(): [] {
  /* Disclose derived commitments first so the OR comparison is over public
   * values (explicit-disclosure). Commitments are already on-ledger when
   * auth succeeds; the localSecretKey itself stays private. */
  const sk = localSecretKey();
  const asClient = disclose(roleCommitment(sk, clientTag()));
  const asApprover = disclose(roleCommitment(sk, approverTag()));
  assert(
    clientPk == asClient || approverPk == asApprover,
    "not a registered approver"
  );
}

/**
 * Milestone deadline is Unix seconds. 0 means unset (no cutoff).
 * blockTimeLt is the Compact standard-library predicate (language 0.23):
 * true only when the including block's time is strictly before the cutoff.
 * https://docs.midnight.network/guides/security-best-practices
 */
circuit assertBeforeDeadline(deadline: Uint<64>): [] {
  if (deadline != 0) {
    assert(blockTimeLt(deadline), "milestone deadline passed");
  }
}

/* ---------- lifecycle circuits ---------- */

/**
 * Register role commitments. Caller proves they are the client by disclosing
 * a commitment derived from their localSecretKey. Agent and extra approver
 * commitments are supplied as public parameters (precomputed off-chain by those parties).
 */
export circuit initialize(
  agentCommitment: Bytes<32>,
  approverCommitment: Bytes<32>
): [] {
  assert(state == EscrowState.CREATED, "can only initialize in CREATED");
  assert(clientPk == pad(32, ""), "already initialized");

  const clientCommitment = roleCommitment(localSecretKey(), clientTag());
  clientPk = disclose(clientCommitment);
  agentPk = disclose(agentCommitment);
  approverPk = disclose(approverCommitment);

  assert(agentPk != clientPk, "agent and client commitments must differ");
  assert(agentPk != approverPk, "agent cannot also be the registered approver");
  assert(clientPk != approverPk, "client and approver commitments must differ");
  assert(clientPk != pad(32, ""), "client commitment must be non-empty");
  assert(agentPk != pad(32, ""), "agent commitment must be non-empty");
  assert(approverPk != pad(32, ""), "approver commitment must be non-empty");
}

/** Client adds a milestone before work starts. Amounts are integer subunits (e.g. lovelace). */
export circuit addMilestone(amount: Uint<64>, deadline: Uint<64>): [] {
  assertIsClient();
  assert(
    state == EscrowState.CREATED || state == EscrowState.FUNDED,
    "milestones only before work starts"
  );
  assert((disclose(amount) as Uint<64>) > 0, "milestone amount must be positive");

  milestoneCount.increment(1);
  const id = disclose(milestoneCount.read() as Uint<64>);
  const amt = disclose(amount);
  /* start() requires milestoneTotal <= funded. Enforce that here so a FUNDED
   * escrow cannot accumulate milestones that make start() unreachable. */
  if (state == EscrowState.FUNDED) {
    assert((milestoneTotal + amt) as Uint<64> <= funded, "milestone total exceeds funded amount");
  }
  milestones.insert(id, Milestone {
    amount: amt,
    status: MilestoneStatus.PENDING,
    proofHash: pad(32, ""),
    deadline: disclose(deadline)
  });
  milestoneTotal = (milestoneTotal + amt) as Uint<64>;
}

/**
 * Client funds the escrow budget (single funding event in this skeleton).
 * Amount must already cover milestones added in CREATED; start() repeats the check.
 */
export circuit fund(amount: Uint<64>): [] {
  assertIsClient();
  assert(state == EscrowState.CREATED, "can only fund in CREATED");
  assert(clientPk != pad(32, ""), "call initialize before fund");
  const amt = disclose(amount);
  assert((amt as Uint<64>) > 0, "fund amount must be positive");
  assert(amt >= milestoneTotal, "fund amount must cover existing milestones");

  funded = amt;
  state = EscrowState.FUNDED;
}

/** Open the engagement once milestones fit the funded budget. */
export circuit start(): [] {
  assertIsClient();
  assert(state == EscrowState.FUNDED, "can only start in FUNDED");
  assert((milestoneCount.read() as Uint<64>) > 0, "need at least one milestone");
  assert(milestoneTotal <= funded, "milestone total exceeds funded amount");

  state = EscrowState.IN_PROGRESS;
}

/**
 * Agent submits a proof commitment (hash) for a pending milestone, or replaces
 * a rejected proof. Resubmit reopens the slot: decidedCount is decremented so
 * settle() still waits until every milestone is released or rejected again.
 * A non-zero deadline must still be in the future (blockTimeLt).
 * Counter.decrement is the Compact standard-library op (Uint<16> amount).
 */
export circuit submitProof(milestoneId: Uint<64>, proofHash: Bytes<32>): [] {
  assertIsAgent();
  assert(state == EscrowState.IN_PROGRESS, "can only submit proofs while IN_PROGRESS");

  const id = disclose(milestoneId);
  assert(milestones.member(id), "unknown milestone");
  const m = milestones.lookup(id);
  assert(
    m.status == MilestoneStatus.PENDING || m.status == MilestoneStatus.REJECTED,
    "milestone has no open proof slot"
  );
  assertBeforeDeadline(m.deadline);
  assert(disclose(proofHash) != pad(32, ""), "proof hash must be non-empty");

  if (m.status == MilestoneStatus.REJECTED) {
    assert((decidedCount.read() as Uint<64>) > 0, "decided count underflow");
    decidedCount.decrement(1);
  }

  milestones.insert(id, Milestone {
    amount: m.amount,
    status: MilestoneStatus.PROOF_SUBMITTED,
    proofHash: disclose(proofHash),
    deadline: m.deadline
  });
}

/**
 * Registered approver (or client) releases one milestone after a proof exists.
 * Agent cannot pass assertIsApprover when agentPk != clientPk/approverPk.
 * Release is also blocked once the milestone deadline has passed.
 */
export circuit approve(milestoneId: Uint<64>): [] {
  assertIsApprover();
  assert(state == EscrowState.IN_PROGRESS, "can only approve while IN_PROGRESS");

  const id = disclose(milestoneId);
  assert(milestones.member(id), "unknown milestone");
  const m = milestones.lookup(id);
  assert(m.status == MilestoneStatus.PROOF_SUBMITTED, "milestone needs a submitted proof");
  assertBeforeDeadline(m.deadline);

  milestones.insert(id, Milestone {
    amount: m.amount,
    status: MilestoneStatus.RELEASED,
    proofHash: m.proofHash,
    deadline: m.deadline
  });
  released = (released + m.amount) as Uint<64>;
  decidedCount.increment(1);
}

/** Approver rejects a proof; funds stay escrowed. Agent may submitProof again. */
export circuit reject(milestoneId: Uint<64>): [] {
  assertIsApprover();
  assert(state == EscrowState.IN_PROGRESS, "can only reject while IN_PROGRESS");

  const id = disclose(milestoneId);
  assert(milestones.member(id), "unknown milestone");
  const m = milestones.lookup(id);
  assert(m.status == MilestoneStatus.PROOF_SUBMITTED, "only a submitted proof can be rejected");

  milestones.insert(id, Milestone {
    amount: m.amount,
    status: MilestoneStatus.REJECTED,
    proofHash: m.proofHash,
    deadline: m.deadline
  });
  decidedCount.increment(1);
}

/** Client opens a dispute (freezes releases). Remembers FUNDED or IN_PROGRESS. */
export circuit dispute(): [] {
  assertIsClient();
  assert(
    state == EscrowState.FUNDED || state == EscrowState.IN_PROGRESS,
    "only FUNDED or IN_PROGRESS can be disputed"
  );
  stateBeforeDispute = state;
  state = EscrowState.DISPUTED;
}

/** Client resolves dispute with a full refund of remaining balance. */
export circuit resolveDisputeRefund(): [] {
  assertIsClient();
  assert(state == EscrowState.DISPUTED, "escrow is not in dispute");
  const bal = (funded - released - refunded) as Uint<64>;
  refunded = (refunded + bal) as Uint<64>;
  state = EscrowState.REFUNDED;
}

/**
 * Client resolves dispute by restoring the pre-dispute state.
 * A dispute opened from FUNDED must not skip start() (milestone / budget checks).
 */
export circuit resolveDisputeResume(): [] {
  assertIsClient();
  assert(state == EscrowState.DISPUTED, "escrow is not in dispute");
  assert(
    stateBeforeDispute == EscrowState.FUNDED || stateBeforeDispute == EscrowState.IN_PROGRESS,
    "dispute has no restorable state"
  );
  if (stateBeforeDispute == EscrowState.FUNDED) {
    state = EscrowState.FUNDED;
  } else {
    state = EscrowState.IN_PROGRESS;
  }
}

/** After every milestone is decided, refund the remainder and settle. */
export circuit settle(): [] {
  assertIsClient();
  assert(state == EscrowState.IN_PROGRESS, "only IN_PROGRESS can be settled");
  assert(
    decidedCount.read() == milestoneCount.read(),
    "all milestones must be released or rejected first"
  );
  const bal = (funded - released - refunded) as Uint<64>;
  refunded = (refunded + bal) as Uint<64>;
  state = EscrowState.SETTLED;
}

/** Cancel before work starts; refund any deposit. */
export circuit cancel(): [] {
  assertIsClient();
  assert(
    state == EscrowState.CREATED || state == EscrowState.FUNDED,
    "can only cancel before work starts"
  );
  const bal = (funded - released - refunded) as Uint<64>;
  refunded = (refunded + bal) as Uint<64>;
  state = EscrowState.CANCELLED;
}
