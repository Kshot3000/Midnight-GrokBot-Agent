pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger counter: Uint<64>;

witness privateAge(): Uint<64>;

export circuit checkAge(): [] {
  // Implicit disclosure of the private comparison outcome via assert.
  // No disclose() is required on the boolean condition itself.
  assert(privateAge() >= 18, "age check failed");
  counter = disclose(privateAge()); // ledger write still requires explicit disclose
}
