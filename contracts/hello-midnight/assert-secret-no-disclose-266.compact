/*
 * assert-secret-no-disclose-266.compact — assert on a secret (witness) does not require disclose().
 *
 * Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
 * Official: https://docs.midnight.network/compact/reference/explicit-disclosure
 *          https://docs.midnight.network/guides/security-best-practices
 *
 * servicedesk#266 (Compact 0.31.1 / language ~0.23 and 0.35.0) reports that
 *   export circuit f(): [] { assert(secretNum() > 5, "too small"); }
 * is ACCEPTED. The compiler does not treat a pure assert on witness data as a disclosure site.
 *
 * Contrast with branching that then writes the ledger, or returning a witness, both of which require disclose().
 * This source does not invent APIs. LOCAL-TRUE. Source only. Not compiled here. Not deployed.
 * Does not claim a fix of the public indexer or node.
 *
 * Pins: Compact ~0.31.1 / language ~0.23, midnight-js 4.1.1, DApp Connector 4.0.1, proof-server 8.1.0.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger calls: Counter;

witness secretNum(): Uint<64>;

// Asserting a property of a witness is allowed without disclose().
// The reported form is accepted by the compiler.
export circuit assertSecretBound(): [] {
  assert(secretNum() > 5, "too small");
  calls.increment(1);
}

// For contrast: returning the witness still requires disclose() (see disclosure-return-vs-ledger-266.compact).
export circuit returnWitness(): Uint<64> {
  return disclose(secretNum());
}
