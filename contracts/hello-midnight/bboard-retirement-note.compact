// Language pin matching the published bulletin board contract and this lab.
pragma language_version >= 0.23;

import CompactStandardLibrary;

// Occupancy flag only. Message and owner stay in the example repo.
export ledger vacant: Boolean;

constructor() {
  vacant = true;
}

/**
 * post — same occupancy invariant as the published bulletin board post circuit.
 * Does not copy Opaque or publicKey; those stay in example-bboard.
 */
export circuit notePostAllowed(): [] {
  assert(vacant, "Attempted to post to an occupied board");
  vacant = false;
}

/**
 * takeDown — same vacancy invariant as the published takeDown circuit.
 * Ownership check stays in the example; this note only tracks occupancy.
 */
export circuit noteTakeDownAllowed(): [] {
  assert(vacant == false, "Attempted to take down post from an empty board");
  vacant = true;
}
