Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger steps: Uint<16>;

constructor() {
  steps = 0;
}

// Range form: both ends are unsigned integer literals, end >= start.
export circuit countRange(): [] {
  for (const i of 0..4) {
    assert(i < 4, "range end is exclusive of the static bound");
    steps = (steps + 1) as Uint<16>;
  }
}

// Size form: the iterated value is a Vector whose length is fixed at compile time.
export circuit countVector(flags: Vector<3, Boolean>): [] {
  for (const flag of flags) {
    if (disclose(flag)) {
      steps = (steps + 1) as Uint<16>;
    }
  }
}
