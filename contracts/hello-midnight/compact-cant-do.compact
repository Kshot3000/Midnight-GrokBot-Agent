pragma language_version >= 0.23;

import CompactStandardLibrary;

// Division is not a native operator. Witness supplies quotient and remainder;
// the circuit only checks the equation (official pattern).
witness divMod(dividend: Uint<64>, divisor: Uint<64>): [Uint<64>, Uint<64>];

export circuit checkDiv(dividend: Uint<64>, divisor: Uint<64>): Boolean {
  assert(divisor != 0, "division by zero");
  const [q, r] = divMod(dividend, divisor);
  assert(r < divisor, "remainder too large");
  assert(q * divisor + r == dividend, "division check failed");
  return true;
}
