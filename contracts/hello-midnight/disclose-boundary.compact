 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger published: Bytes<32>;
export ledger writes: Counter;

// Ledger write is the public boundary. disclose only clears the check.
export circuit publishNote(note: Bytes<32>): [] {
  published = disclose(note);
  writes.increment(1);
}

// disclose into a local does not write the ledger, return the note, or call
// another contract. The note stays off the public boundary.
export circuit holdPrivate(note: Bytes<32>): [] {
  const cleared = disclose(note);
  assert(cleared != published, "local disclose is not a ledger write");
}
