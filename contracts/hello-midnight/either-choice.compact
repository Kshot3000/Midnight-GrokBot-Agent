pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger isLeft: Boolean;
export ledger payload: Uint<64>;

export circuit storeLeft(value: Uint<64>): [] {
  assert(value != 0, "left payload must be non-default");
  const choice = left<Uint<64>, Uint<64>>(value);
  assert(choice.isLeft, "left() must set isLeft");
  assert(choice.right == 0, "right must stay default<Uint<64>> when isLeft");
  isLeft = disclose(choice.isLeft);
  payload = disclose(choice.left);
}

export circuit storeRight(value: Uint<64>): [] {
  assert(value != 0, "right payload must be non-default");
  const choice = right<Uint<64>, Uint<64>>(value);
  assert(!choice.isLeft, "right() must clear isLeft");
  assert(choice.left == 0, "left must stay default<Uint<64>> when right");
  isLeft = disclose(choice.isLeft);
  payload = disclose(choice.right);
}
