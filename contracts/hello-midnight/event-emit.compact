/*
 * event-emit.compact — emit a standard event type.
 *
 * Official: https://docs.midnight.network/compact/reference/compact-reference
 *   Events are emitted via the form emit(e) where e has a standard event type.
 *   Type of every emit form is [].
 *   Attempt to emit from constructor is a static error.
 * Official standard events: https://docs.midnight.network/compact/standard-library/exports
 *   e.g. ShieldedSpend { nullifier: Bytes<32> }
 *
 * Upstream: midnightntwrk/midnight-docs#1387 (Kapa could not answer how to declare/use emit).
 * This uses a standard library event; does not invent a custom event API.
 * Compact pin: ~0.31.1 / language ~0.23. Not deployed.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger rounds: Counter;

export circuit spendAndTick(nullifier: Bytes<32>): [] {
  // Official ShieldedSpend event; nullifier must be disclosed if witness-derived.
  emit(ShieldedSpend { nullifier: disclose(nullifier) });
  rounds.increment(1);
}
