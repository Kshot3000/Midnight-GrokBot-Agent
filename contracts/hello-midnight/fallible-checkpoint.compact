pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger marks: Counter;

// fallible section: checkpoint before any later kernel read.
export circuit markFallible(): [] {
  kernel.checkpoint();
  assert(kernel.blockTimeGreaterThan(0), "block time not yet positive");
  marks.increment(1);
}
