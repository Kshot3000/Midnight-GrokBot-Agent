pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger selfBytes: Bytes<32>;
export ledger inserts: Counter;
export ledger items: MerkleTree<10, Field>;

export circuit rememberSelf(): [] {
  selfBytes = disclose(kernel.self().bytes);
}

export circuit insertOne(item: Field): [] {
  items.insert(disclose(item));
  inserts.increment(1);
}
