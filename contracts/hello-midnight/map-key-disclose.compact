/*
 * map-key-disclose.compact — circuit argument used as a Map key requires disclose()
 * even inside assert(m.member(...)).
 *
 * Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
 * Official:
 *   https://docs.midnight.network/compact/reference/explicit-disclosure
 *   https://docs.midnight.network/compact/reference/writing (Confidentiality section)
 *
 * servicedesk#266 (Compact 0.31.1 / language ~0.23 and also 0.35.0):
 *   export circuit f(k: Bytes<32>): [] { assert(m.member(k), "missing"); }
 *   is REJECTED with potential witness-value disclosure must be declared.
 *   The compiler treats the Map key position as a disclosure site.
 *
 * This source shows the form that satisfies the reported rule: disclose(k).
 * It does not claim the upstream docs are updated, and does not fix the public
 * indexer or node. LOCAL-TRUE. Source only. Not compiled here. Not deployed.
 *
 * Pins: Compact ~0.31.1 / language ~0.23, midnight-js 4.1.1, DApp Connector 4.0.1,
 * proof-server 8.1.0.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger m: Map<Bytes<32>, Uint<64>>;

// Circuit argument used as a Map key. The reported compiler rejects the bare
// form assert(m.member(k)). The form that satisfies the check uses disclose(k).
export circuit hasKey(k: Bytes<32>): [] {
  assert(m.member(disclose(k)), "missing");
}

// Companion store path: writing a disclosed argument is the public-ledger case
// already covered by the Explicit disclosure page.
export circuit setKey(k: Bytes<32>, v: Uint<64>): [] {
  m.insert(disclose(k), disclose(v));
}
