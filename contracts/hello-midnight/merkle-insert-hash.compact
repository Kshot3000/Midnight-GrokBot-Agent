/*
 * merkle-insert-hash.compact — record the official insert vs insertHash split.
 *
 * Official ledger ADT (do not invent a hash formula):
 *   https://docs.midnight.network/compact/reference/ledger-adt
 *   MerkleTree.insert(item: value_type) inserts a new leaf at the first free index.
 *   MerkleTree.insertHash(hash: Bytes<32>) inserts a new leaf with a given hash
 *   at the first free index.
 *   path recovery(leaf: value_type) is TypeScript-only and returns undefined
 *   if no such leaf exists. pathForLeaf(index, leaf) errors if that leaf is not
 *   at the given index.
 *
 * Upstream: https://github.com/midnightntwrk/midnight-docs/issues/63
 * The open issue reports that a path built for the raw value succeeds after
 * insert and fails after insertHash, because the docs do not say what
 * transformation (if any) insertHash applies before the leaf is stored.
 * This file does not guess the transformation. It does not deploy.
 * It does not claim the public indexer or node was fixed.
 *
 * Language pin: Compact ~0.31.1 / language 0.23.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger leaves: MerkleTree<10, Bytes<32>>;

// insert stores the value as a leaf. A later TypeScript leaf lookup on
// the same Bytes<32> can succeed (issue #63).
export circuit insertRaw(item: Bytes<32>): [] {
  leaves.insert(disclose(item));
}

// insertHash stores a leaf from an already-hashed Bytes<32>. The official
// page does not define a function that turns the preimage back into the
// stored leaf, so path recovery on the preimage is not a documented path.
export circuit insertPrehashed(hash: Bytes<32>): [] {
  leaves.insertHash(disclose(hash));
}

// checkRoot is the documented circuit test. It does not recover a path.
export circuit rootMatches(rt: MerkleTreeDigest): Boolean {
  return leaves.checkRoot(rt);
}
