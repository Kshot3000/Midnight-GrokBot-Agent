/*
 * no-bitwise.compact — public-network Compact has no bitwise operators.
 *
 * Official grammar (published page is labeled language 0.26.0; this lab pin
 * stays on language <= 0.23 / Compact toolchain ~0.31.1):
 *   https://docs.midnight.network/compact/reference/compact-grammar
 * Binary arithmetic operators in the language reference are only +, -, *:
 *   https://docs.midnight.network/compact/reference/compact-reference
 * Logical operators are || and &&. There is no &, |, ^, <<, >>, or >>>.
 * CompactStandardLibrary exports do not list a shift or bitwise circuit:
 *   https://docs.midnight.network/compact/standard-library/exports
 *
 * Upstream: midnightntwrk/midnight-docs#1387
 * Kapa could not answer "does compact have bit operator". This file does
 * not invent one. A Boolean folds to 0 or 1 with the documented ternary,
 * then is disclosed into a Uint<8>. Not a deploy, indexer fix, or node fix.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger flags: Uint<8>;

export circuit storeFlag(flag: Boolean): [] {
  const bit = flag ? 1 : 0;
  assert(bit == 0 || bit == 1, "flag must fold to 0 or 1");
  flags = disclose(bit as Uint<8>);
}
