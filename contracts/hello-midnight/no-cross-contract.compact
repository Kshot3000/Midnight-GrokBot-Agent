/*
 * no-cross-contract.compact — stay on a local circuit for ledger 8.
 *
 * Official compiler-errors page:
 *   "cross-contract calls are not yet supported"
 *   triggers when compiling a cross-contract call for a ledger earlier
 *   than 9, or with ZKIR v2. Those calls arrived with ledger 9 and
 *   ZKIR v3 (toolchain 0.33.0 and later).
 *   https://docs.midnight.network/troubleshoot/compiler-errors
 * Support matrix: Preview, Preprod, and Mainnet run ledger 8. Compact
 * 0.34.0 / 0.35.0 target ledger 9 and do not deploy on those networks.
 *   https://docs.midnight.network/relnotes/support-matrix
 * Language reference (call form, not used here):
 *   https://docs.midnight.network/compact/reference/compact-reference
 *
 * Upstream: midnightntwrk/servicedesk#236
 * Bumping off 0.31.1 to get cross-contract calls is the mismatch that
 * issue reports. This file does not invent a Compact API and is not deployed.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger rounds: Counter;

// Local circuit. No contract-typed argument and no callee circuit call.
export circuit tick(): [] {
  rounds.increment(1);
}
