/*
 * no-empty-bytes.compact — avoid the empty Bytes constructor that fails to compile.
 *
 * Upstream: midnightntwrk/midnight-docs#1487
 * The Test and debug page sample (lines 34-54) uses Bytes<32>{} and a top-level const,
 * and a ledger write without disclose(). That does not compile on Compact ~0.31.1 /
 * language >= 0.23.
 *
 * Official: https://docs.midnight.network/compact/reference/writing
 * This file is source only. Not compiled. Not deployed. Does not fix the public page,
 * indexer, or node.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger owner: Bytes<32>;

export circuit setOwner(newOwner: Bytes<32>): [] {
  owner = disclose(newOwner);
}
