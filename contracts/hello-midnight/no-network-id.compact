pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger selfBytes: Bytes<32>;

export circuit rememberSelf(): [] {
  selfBytes = disclose(kernel.self().bytes);
}

export circuit noteSpend(n: Bytes<32>): [] {
  emit(ShieldedSpend { nullifier: disclose(n) });
}

export circuit decodeFlag(flag: Bytes<1>): Boolean {
  return deserialize<Boolean, 1>(flag);
}
