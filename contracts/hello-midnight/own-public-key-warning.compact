pragma language_version >= 0.23;
import CompactStandardLibrary;

export ledger owner: Bytes<32>;
witness secretKey(): Bytes<32>;

// Store a domain-separated hash of the secret. Caller must know the secret.
export circuit claimOwnership(): [] {
  owner = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "lab:owner:"), secretKey()]));
}

// Re-derive and assert. A lying prover who does not hold secretKey() fails.
export circuit onlyOwner(): [] {
  assert(owner == persistentHash<Vector<2, Bytes<32>>>([pad(32, "lab:owner:"), secretKey()]), "not owner");
}

// ownPublicKey() may name a recipient after the secret gate has already run.
// It must not be the gate itself.
