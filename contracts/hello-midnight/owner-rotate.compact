/*
 * owner-rotate.compact — rotate a derived owner commitment.
 *
 * Official procedure (do not invent a replacement API):
 *   https://docs.midnight.network/guides/security-best-practices
 *   section "Rotating an owner key"
 *   https://docs.midnight.network/compact/smart-contract-security
 *
 * Upstream: midnightntwrk/midnight-docs#902
 * ownPublicKey() is a witness. The synced stdlib and compact-runtime
 * pages still lack the warning bar. This file is the lab warning.
 * It does not edit midnight-docs and does not deploy.
 *
 * Extra invariant the official rotateOwner snippet does not assert:
 * newOwner must be non-empty and must differ from the current commitment,
 * so a rotation cannot clear the slot or no-op it.
 *
 * Language pin: Compact ~0.31.1 / language >= 0.23 (lab). Official sample
 * uses `pragma language_version 0.23.0`.
 *
 * LOCAL-TRUE. Source only until the next compact compile. Not deployed.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger owner: Bytes<32>;

witness secretKey(): Bytes<32>;

circuit derivePublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "hello-midnight:owner"),
    sk
  ]);
}

export circuit claimOwnership(): [] {
  assert(owner == pad(32, ""), "owner already claimed");
  const sk = secretKey();
  assert(sk != pad(32, ""), "secret must be non-empty");
  owner = disclose(derivePublicKey(sk));
}

export circuit rotateOwner(newOwner: Bytes<32>): [] {
  assert(owner != pad(32, ""), "claim ownership first");
  assert(derivePublicKey(secretKey()) == owner, "not owner");
  const next = disclose(newOwner);
  assert(next != pad(32, ""), "new owner must be non-empty");
  assert(next != owner, "new owner must differ");
  owner = next;
}

export circuit withdraw(): [] {
  assert(owner != pad(32, ""), "claim ownership first");
  assert(derivePublicKey(secretKey()) == owner, "not owner");
}
