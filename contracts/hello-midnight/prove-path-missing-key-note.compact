/*
 * prove-path-missing-key-note.compact — pointer only.
 *
 * When the zk-config provider cannot supply the circuit IR, proof-server
 * rejects /check or /prove. midnight-js 4.1.1 drops the response body that
 * names the missing built-in key (servicedesk#243). Official local-proving
 * guide and proof-server error reference describe the proving setup; they do
 * not document the dropped-body behaviour.
 *
 * This file has no circuit that would trigger the failure. It exists so the
 * contracts/ tree records the known prove-path shape. LOCAL-TRUE. Source
 * only. Not compiled. Not deployed. Does not fix the public proof server,
 * indexer, or node.
 *
 * Upstream: https://github.com/midnightntwrk/servicedesk/issues/243
 * Official: https://docs.midnight.network/guides/local-proving
 * Pins: Compact ~0.31.1 / language ~0.23, midnight-js 4.1.1, proof-server 8.1.0.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger calls: Counter;

// Minimal circuit that can be proven when its ZKIR is present.
// If the keys are missing, the prove path fails with the shape in #243.
export circuit bump(): [] {
  calls.increment(1);
}
