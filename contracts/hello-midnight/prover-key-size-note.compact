// Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation

pragma language_version 0.23;

export ledger sizeNote: Uint<32>;

export circuit recordSizeNote(mb: Uint<32>): [] {
  // Builders: sizes >= 90 are flagged by the lab classifier for #203.
  sizeNote = disclose(mb);
}
