// Compact pin for midnightntwrk/servicedesk#249
// Pure circuits compile into PureCircuits / pureCircuits and are callable locally.
// They are not valid targets for cross-contract calls (no standalone proof).
// Language pin ~0.23 / Compact ~0.31.1. LOCAL-TRUE. Not compiled or deployed here.
// Official: https://docs.midnight.network/compact/reference/compact-reference
// Official: https://docs.midnight.network/guides/compact-javascript-runtime
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/249
//
// Built by @kshot9000 https://x.com/kshot9000
// Email: kshot9000@gmail.com
// Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
// Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation

pragma language_version 0.23;

import CompactStandardLibrary;

// Pure: no ledger operations, no witnesses. Eligible for pureCircuits when exported.
export pure circuit double(n: Uint<64>): Uint<64> {
  return n + n;
}

// Local call to the pure circuit is valid. A cross-contract call to a pure
// circuit is refused (CoIP-2 decision noted in servicedesk#249).
export circuit noteLocalOnly(): [] {
  const doubled = double(21);
  assert(doubled == 42, "pure circuit local call failed");
}
