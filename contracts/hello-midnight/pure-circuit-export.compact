/*
 * pure-circuit-export.compact
 *
 * Minimal sample of an exported pure circuit on language 0.23.
 * Pure circuits have no ledger access and no witnesses; the compiler emits
 * JavaScript only (no ZKIR / proving key).
 *
 * Upstream gap (later toolchain): pure circuits declared in a *contract type*
 * compile on 0.35 but every call fails with PureInterfaceCircuit.
 * See https://github.com/midnightntwrk/servicedesk/issues/249
 *
 * On the lab pin (Compact 0.31.1 / language 0.23 / compact-runtime 0.16.0)
 * prefer ordinary exported pure circuits, not pure entries inside contract
 * type declarations. This file does not declare a contract type.
 *
 * Official:
 *   https://docs.midnight.network/compact/reference/compact-reference
 *   https://docs.midnight.network/guides/compact-javascript-runtime
 *
 * LOCAL-TRUE. Does not claim a fix of the public indexer or node.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version 0.23;

import CompactStandardLibrary;

export pure circuit add(a: Uint<8>, b: Uint<8>): Uint<16> {
  return a + b;
}

export ledger calls: Counter;

export circuit bump(): [] {
  calls.increment(1);
}
