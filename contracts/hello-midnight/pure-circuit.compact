// Lab pure circuit: outputs from inputs only. No ledger, no witnesses.
// Official: https://docs.midnight.network/compact/reference/compact-reference
// Upstream gap note: https://github.com/midnightntwrk/servicedesk/issues/249
// Pins: Compact ~0.31.1 / language ~0.23

pragma language_version >= 0.23;

// pure: computes outputs from inputs without ledger or witnesses.
export pure circuit pureAdd(a: Uint<64>, b: Uint<64>): Uint<64> {
  // disclose before any public use; pure circuits do not write the ledger.
  const x = disclose(a);
  const y = disclose(b);
  // result type is wider; cast back as documented for same-width storage.
  (x + y) as Uint<64>
}

