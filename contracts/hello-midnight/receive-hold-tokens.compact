pragma language_version 0.23;

import CompactStandardLibrary;

export ledger pot: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

// Unshielded receive (Private Party pattern). Caller's wallet funds the output.
export circuit receiveUnshieldedExample(amount: Uint<128>): [] {
  receiveUnshielded(default<Bytes<32>>, disclose(amount));
}

// Shielded receive + hold for later spend (Private Tip Jar pattern).
// insertCoin only succeeds for a coin created in the current transaction.
export circuit receiveShieldedAndHold(coin: ShieldedCoinInfo): [] {
  receiveShielded(disclose(coin));
  pot.insertCoin(
    disclose(coin.nonce),
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}
