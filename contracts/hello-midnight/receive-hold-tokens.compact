// Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation

pragma language_version 0.23;

import CompactStandardLibrary;

// Map of nonce -> qualified coin for holding shielded coins created in this tx
export ledger pot: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

export circuit receiveUnshieldedExample(amount: Uint<128>): [] {
  // Official: receiveUnshielded(color, amount) claims the amount for this contract.
  // Caller's wallet funds it when balancing the transaction (see Private Party).
  const color = nativeToken(); // NIGHT
  receiveUnshielded(color, disclose(amount));
}

export circuit receiveAndHoldShielded(coin: ShieldedCoinInfo): [] {
  // Official Private Tip Jar pattern:
  // 1. Client builds a fresh coin (not from wallet UTXO).
  // 2. receiveShielded claims it for this contract.
  // 3. insertCoin stores it with mt_index filled for same-tx coin so it can be spent later.
  receiveShielded(disclose(coin));
  pot.insertCoin(
    disclose(coin.nonce),
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}

// Note: spending later uses sendShielded on a QualifiedShieldedCoinInfo from the map.
// insertCoin / writeCoin at receive or mint time avoids needing the indexer for mt_index.
// Official docs: https://docs.midnight.network/compact/reference/ledger-adt
