pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

// Unshielded receive (token-transfers / Private Party).
// The caller's wallet funds the amount when it balances the transaction.
export circuit receiveUnshieldedAmount(color: Bytes<32>, amount: Uint<128>): [] {
  receiveUnshielded(color, disclose(amount));
}

// NIGHT receive (token-transfers uses default; Private Party uses nativeToken()).
export circuit receiveNight(amount: Uint<128>): [] {
  receiveUnshielded(default<Bytes<32>>, disclose(amount));
}

// Shielded receive + custody (Private Tip Jar pattern).
// coin is a fresh ShieldedCoinInfo the DApp constructs; not an existing wallet coin.
// insertCoin fills mt_index for a coin created in this transaction so sendShielded can spend it later.
export ledger pot: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

export circuit receiveAndHoldShielded(coin: ShieldedCoinInfo): [] {
  assert(coin.value > 0, "value required");
  assert(!pot.member(disclose(coin.nonce)), "nonce already held");
  receiveShielded(disclose(coin));
  pot.insertCoin(
    disclose(coin.nonce),
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}
