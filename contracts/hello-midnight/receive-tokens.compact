 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

// Optional pot for shielded coins the contract holds for later spend.
export ledger pot: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

// Receive a custom unshielded color (tokenType domain + self).
export circuit receiveCustomUnshielded(domain: Bytes<32>, amount: Uint<128>): [] {
  const color = tokenType(disclose(domain), kernel.self());
  receiveUnshielded(color, disclose(amount));
}

// Receive native NIGHT (unshielded). nativeToken() or default<Bytes<32>> per examples.
export circuit receiveNight(amount: Uint<128>): [] {
  receiveUnshielded(nativeToken(), disclose(amount));
}

// Receive a fresh shielded coin and store it so it can be spent later.
// Client constructs ShieldedCoinInfo with a fresh nonce; wallet pays on balance.
export circuit receiveAndHoldShielded(coin: ShieldedCoinInfo): [] {
  assert(coin.value > 0, "zero value");
  assert(!pot.member(disclose(coin.nonce)), "nonce already held");
  receiveShielded(disclose(coin));
  pot.insertCoin(
    disclose(coin.nonce),
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
  );
}
