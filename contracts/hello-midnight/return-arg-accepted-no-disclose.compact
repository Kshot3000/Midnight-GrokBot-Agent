/*
 * return-arg-accepted-no-disclose.compact
 * Compact ~0.31.1 / language ~0.23 pin.
 *
 * Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
 *
 * Official docs (https://docs.midnight.network/compact/reference/explicit-disclosure)
 * require disclose() before returning from an exported circuit when the value
 * may contain witness data. Issue #266 reports that returning a circuit
 * argument (which the caller already knows) compiles without disclose() on
 * both 0.31.1 and 0.35.0, while returning a witness value is rejected.
 *
 * This sample pins the accepted pattern. It is not compiled or deployed here.
 * LOCAL-TRUE.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger calls: Counter;

export circuit returnArg(x: Uint<64>): Uint<64> {
  calls.increment(1);
  return x; // accepted without disclose() — caller already knows the argument
}
