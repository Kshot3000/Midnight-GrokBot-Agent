pragma language_version 0.23;
import CompactStandardLibrary;

export ledger calls: Counter;

witness secretNum(): Uint<64>;

// Returning a circuit argument needs no disclose() because the caller already knows it.
// Official: https://docs.midnight.network/compact/reference/writing
export circuit returnArg(x: Uint<64>): Uint<64> {
  calls.increment(1);
  return x;
}

// Returning a witness value requires disclose(). The value reaches the DApp
// but is not written to the ledger or readable in the published transaction.
// Official: https://docs.midnight.network/guides/security-best-practices
export circuit returnWitness(): Uint<64> {
  calls.increment(1);
  return disclose(secretNum());
}

