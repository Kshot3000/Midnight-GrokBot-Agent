// Lab Compact: returning a circuit argument does not require disclose();
// returning a witness does. Neither return is published on-chain.
// Official: https://docs.midnight.network/compact/reference/explicit-disclosure
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not deployed.

pragma language_version >= 0.23;

import CompactStandardLibrary;

witness secretNum(): Uint<64>;

export ledger calls: Counter;

// Argument return is accepted without disclose(). Caller already knows the argument.
export circuit returnArg(x: Uint<64>): Uint<64> {
  calls.increment(1);
  return x;
}

// Witness return requires disclose(). Value reaches the DApp but is not in the published tx.
export circuit returnWitness(): Uint<64> {
  calls.increment(1);
  return disclose(secretNum());
}

