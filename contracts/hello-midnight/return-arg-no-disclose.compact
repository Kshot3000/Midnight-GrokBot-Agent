// Lab Compact: returning a circuit argument does not require disclose().
// Official: https://docs.midnight.network/compact/reference/explicit-disclosure
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not deployed.

pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger last: Uint<64>;

// Argument is known to the caller. Compiler accepts the bare return.
export circuit echo(x: Uint<64>): Uint<64> {
  return x;
}

// Same for a pure circuit.
export pure circuit add(a: Uint<8>, b: Uint<8>): Uint<16> {
  return a + b;
}

