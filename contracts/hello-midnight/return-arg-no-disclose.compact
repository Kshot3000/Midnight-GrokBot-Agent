// Lab Compact: returning an exported-circuit argument needs no disclose().
// Returning a witness value does. Return values reach the calling DApp
// but are not written into the published transaction.
// Official: https://docs.midnight.network/compact/reference/explicit-disclosure
// Related: https://docs.midnight.network/guides/security-best-practices
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not deployed.

pragma language_version >= 0.23;

import CompactStandardLibrary;

witness secretNum(): Uint<64>;

export ledger stored: Uint<64>;

// Argument x is already known to the caller. Compiler accepts return x;
// without disclose() on Compact 0.31.1 / language 0.23 (and later).
export circuit returnArg(x: Uint<64>): Uint<64> {
  return x;
}

// Witness value leaves the circuit to the DApp, so disclose is required.
// The value is not stored on the ledger and is not in the published tx raw bytes.
export circuit returnWitness(): Uint<64> {
  return disclose(secretNum());
}

// Positive control: ledger write is public and needs disclose.
export circuit storeArg(x: Uint<64>): [] {
  stored = disclose(x);
}

