// Lab Compact: returning a circuit argument needs no disclose(); returning a witness does.
// Official: https://docs.midnight.network/compact/reference/explicit-disclosure
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not deployed. Does not claim a fix of public indexer or node.

pragma language_version >= 0.23;

import CompactStandardLibrary;

witness secretNum(): Uint<64>;

export ledger val: Uint<64>;

// Returning a circuit argument is accepted without disclose().
// The caller already knows its own argument.
export circuit returnArg(x: Uint<64>): Uint<64> {
  return x;
}

// Returning a witness value requires disclose().
export circuit returnWitness(): Uint<64> {
  return disclose(secretNum());
}

// Ledger store still requires disclose() for witness data.
export circuit store(x: Uint<64>): [] {
  val = disclose(x);
}

