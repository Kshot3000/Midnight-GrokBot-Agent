// Lab Compact invariant: pure exported circuit may return its arguments without disclose().
// Official: https://docs.midnight.network/compact/reference/explicit-disclosure
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not compiled in this lab. Not deployed.
// Does not claim a fix of the public indexer, node, or docs.

pragma language_version >= 0.23;

import CompactStandardLibrary;

// Pure circuit: returning sum of arguments is accepted without disclose().
// Caller already knows its own arguments.
export pure circuit addArgs(a: Uint<8>, b: Uint<8>): Uint<16> {
  return a + b;
}

// Contrast: returning a witness still requires disclose() even in non-pure.
witness secretNum(): Uint<64>;
export circuit returnSecret(): Uint<64> {
  return disclose(secretNum());
}

