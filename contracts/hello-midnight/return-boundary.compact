/*
 * return-boundary.compact — exported circuit returns leave the circuit but
 * are not written into the published transaction.
 *
 * Official reads:
 *   https://docs.midnight.network/guides/security-best-practices
 *   "The return value of an exported circuit | No, the transaction carries
 *    only a randomized commitment to the call's inputs and outputs."
 *   "A return value is not written to the ledger or readable in the
 *    transaction; only a randomized commitment to the call's inputs and
 *    outputs is. The compiler still requires disclose() to return a value
 *    that comes from a witness function, because the value leaves the
 *    circuit, to your DApp or to a calling contract."
 *   https://docs.midnight.network/compact/reference/explicit-disclosure
 *
 * Upstream: midnightntwrk/servicedesk#266
 * Issue #266 measured that return disclose(witness) and return of an
 * argument are absent from the published transaction raw bytes, while a
 * disclosed ledger write is present. Returning an argument does not need
 * disclose(); returning a witness value does.
 *
 * Language pin: Compact ~0.31.1 / language ~0.23.
 * LOCAL-TRUE. Source only. Not compiled here. Not deployed.
 * This file does not fix the public indexer or node.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger stored: Bytes<32>;
export ledger calls: Counter;

witness secretMarker(): Bytes<32>;

// Argument is already known to the caller. Compiler accepts without disclose().
export circuit returnArg(x: Bytes<32>): Bytes<32> {
  calls.increment(1);
  return x;
}

// Witness value leaves the circuit to the DApp. disclose() is required.
// The value is not placed in the published transaction.
export circuit returnWitness(): Bytes<32> {
  calls.increment(1);
  return disclose(secretMarker());
}

// Positive control: disclosed ledger write is on-chain.
export circuit storeArg(x: Bytes<32>): [] {
  stored = disclose(x);
  calls.increment(1);
}
