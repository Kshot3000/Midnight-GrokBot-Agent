// Lab Compact: returning from an exported circuit.
// Official: https://docs.midnight.network/compact/reference/explicit-disclosure
// "a Compact program must explicitly declare its intention to disclose data that might be private before storing it in the public ledger, returning it from an exported circuit, or passing it to another contract."
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not deployed. Does not claim a fix of the public indexer or node.
// Issue #266 reports that a returned value reaches the calling DApp (callTx.private.result) but is not present in the published transaction raw bytes, even when wrapped in disclose().

pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger calls: Counter;

witness secretValue(): Bytes<32>;

// Returning a witness requires disclose() (compiler rejects the bare form).
// The returned value is handed to the DApp; per #266 it is not in the published tx.
export circuit returnWitness(): Bytes<32> {
  calls.increment(1);
  return disclose(secretValue());
}

// Returning a circuit argument is accepted without disclose() on Compact 0.31.1
// (the caller already knows its own arguments). Issue #266 confirmed this.
export circuit returnArg(x: Bytes<32>): Bytes<32> {
  calls.increment(1);
  return x;
}

// Positive control: ledger store of a disclosed argument is the on-chain disclosure site.
export circuit storeArg(x: Bytes<32>): [] {
  calls.increment(1);
  // stored would be the ledger field; omitted here to keep the sample focused.
  // The disclose() is required for any ledger write of argument data.
}

