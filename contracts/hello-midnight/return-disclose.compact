// Lab Compact: returning a disclosed witness value from an exported circuit.
// Official: https://docs.midnight.network/compact/reference/explicit-disclosure
// "disclosure does not occur just when witness data is stored in the ledger
// but also when returned from an exported circuit"
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Issue reports that the returned value reaches the calling DApp but is not
// present in the published transaction bytes. This sample follows the
// documented disclose() requirement for the return path.
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not deployed. Does not claim a fix to the public
// indexer, node, or docs.

pragma language_version >= 0.23;

import CompactStandardLibrary;

witness secretValue(): Bytes<32>;

export ledger calls: Counter;

// Return path requires disclose() for witness data, per official docs.
// The value is handed to the caller; the issue reports it is not written
// into the published transaction the way a ledger store is.
export circuit returnWitness(): Bytes<32> {
  calls.increment(1);
  return disclose(secretValue());
}

// Circuit arguments are known to the caller. Issue #266 reports the
// compiler accepts return of an argument without disclose().
export circuit returnArg(x: Bytes<32>): Bytes<32> {
  calls.increment(1);
  return x;
}

