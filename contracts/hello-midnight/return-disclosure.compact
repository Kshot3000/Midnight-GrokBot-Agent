// Lab Compact: returning an exported circuit argument does not require disclose();
// returning a witness value does. Neither return appears in the published transaction.
// Official: https://docs.midnight.network/guides/security-best-practices
// "A return value is not written to the ledger or readable in the transaction"
// and https://docs.midnight.network/compact/reference/writing
// "data contained within the arguments to an exported circuit is not considered disclosed when it is returned from that circuit"
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not deployed.

pragma language_version >= 0.23;

import CompactStandardLibrary;

witness secret(): Uint<64>;

export circuit returnArg(x: Uint<64>): Uint<64> {
  // Argument already known to the caller; no disclose required.
  return x;
}

export circuit returnWitness(): Uint<64> {
  // Witness value leaves the circuit; compiler requires disclose().
  return disclose(secret());
}

