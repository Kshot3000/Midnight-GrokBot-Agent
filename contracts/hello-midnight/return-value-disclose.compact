// Lab Compact: return of a circuit argument needs no disclose();
// return of a witness requires disclose().
// Neither appears in the published transaction (observed on local network).
// Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
// Official: https://docs.midnight.network/compact/reference/explicit-disclosure
// Pins: Compact ~0.31.1 / language ~0.23
// LOCAL-TRUE. Source only. Not deployed.

pragma language_version 0.23;

import CompactStandardLibrary;

export ledger stored: Bytes<32>;
export ledger calls: Counter;

witness secretValue(): Bytes<32>;

// Argument return is accepted without disclose().
// The caller already knows its own argument.
export circuit returnArg(x: Bytes<32>): Bytes<32> {
  calls.increment(1);
  return x;
}

// Witness return requires disclose() or the compiler rejects.
// The returned value reaches the DApp but is not in the published tx.
export circuit returnWitness(): Bytes<32> {
  calls.increment(1);
  return disclose(secretValue());
}

// Positive control: disclose + ledger write *does* appear on chain.
export circuit storeArg(x: Bytes<32>): [] {
  stored = disclose(x);
}

