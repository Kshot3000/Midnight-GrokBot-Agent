/*
 * return-value-disclosure.compact — return values leave the circuit but are not on-chain.
 *
 * Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
 * Official:
 *   https://docs.midnight.network/compact/reference/explicit-disclosure
 *   https://docs.midnight.network/guides/security-best-practices
 *   https://docs.midnight.network/guides/build-a-private-smart-contract
 *
 * servicedesk#266 (Compact 0.31.1 / language ~0.23) reports:
 * - Returning a circuit argument (`return x;`) is ACCEPTED without disclose().
 * - Returning a witness value is REJECTED without disclose().
 * - Neither returned value appears in the published transaction; only a randomized commitment does.
 * - A disclosed ledger write does appear.
 *
 * Official docs confirm the return is not readable in the transaction and that disclose() on a witness return is required because the value leaves the circuit to the DApp (or caller), not because it is published on-chain.
 *
 * This source does not invent APIs. LOCAL-TRUE. Source only. Not compiled here. Not deployed.
 * Does not claim a fix of the public indexer or node.
 *
 * Pins: Compact ~0.31.1 / language ~0.23, midnight-js 4.1.1, DApp Connector 4.0.1, proof-server 8.1.0.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger stored: Bytes<32>;

witness secret(): Bytes<32>;

// Returning a circuit argument needs no disclose() (caller already knows it).
export circuit returnArg(x: Bytes<32>): Bytes<32> {
  return x;
}

// Returning a witness value requires disclose() so it may leave the circuit to the DApp.
export circuit returnWitness(): Bytes<32> {
  return disclose(secret());
}

// Ledger write of a disclosed argument is the on-chain disclosure site.
export circuit storeArg(x: Bytes<32>): [] {
  stored = disclose(x);
}
