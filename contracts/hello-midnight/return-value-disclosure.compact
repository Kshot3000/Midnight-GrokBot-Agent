/*
 * return-value-disclosure.compact — return values from exported circuits.
 *
 * Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
 * Official:
 *   https://docs.midnight.network/compact/reference/writing (Confidentiality)
 *   https://docs.midnight.network/guides/security-best-practices (On-chain visibility)
 *
 * From official docs (language ~0.23):
 * - Data in arguments to an exported circuit is not considered disclosed when returned,
 *   because the caller already knows it. Compiler accepts `return x;` without disclose().
 * - Returning a witness value requires disclose(), because the value leaves the circuit.
 * - A return value is not written to the ledger and is not readable in the published
 *   transaction; only a randomized commitment to the call's inputs and outputs is.
 *   disclose() on a return clears the compiler check but does not publish the value on-chain.
 *
 * This source does not invent APIs. LOCAL-TRUE. Source only. Not compiled here. Not deployed.
 * Does not claim a fix of the public indexer, node, or docs.
 *
 * Pins: Compact ~0.31.1 / language ~0.23, midnight-js 4.1.1, DApp Connector 4.0.1, proof-server 8.1.0.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

witness secretValue(): Bytes<32>;

export ledger calls: Counter;

// Argument is already known to the caller. No disclose() required.
export circuit returnArg(x: Bytes<32>): Bytes<32> {
  calls.increment(1);
  return x;
}

// Witness value leaves the circuit; disclose() is required.
export circuit returnWitness(): Bytes<32> {
  calls.increment(1);
  return disclose(secretValue());
}
