pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger note: Bytes<32>;

export circuit recordHash(value: Bytes<32>): [] {
  // persistentHash is on the 0.16.0 surface. Do not call jubjubSchnorr*.
  note = disclose(persistentHash<Bytes<32>>(value));
}
