pragma language_version 0.23;
import CompactStandardLibrary;

export ledger note: Uint<32>;

export circuit pinRuntimeNote(): [] {
  // Ledger 8 public networks pair toolchain 0.31.1 with runtime 0.16.0.
  note = 16;
}
