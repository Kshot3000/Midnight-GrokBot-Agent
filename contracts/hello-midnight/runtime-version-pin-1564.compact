pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger calls: Counter;

// Minimal exported circuit that stays on the 0.16.0 / 0.31.1 surface.
// No JubJub Schnorr helpers (those land on the 0.19.0 / 0.20.0 line).
export circuit ping(): [] {
  calls.increment(1);
}
