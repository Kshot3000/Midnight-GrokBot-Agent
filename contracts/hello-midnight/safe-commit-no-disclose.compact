/*
 * safe-commit-no-disclose.compact — persistentCommit and transientCommit
 * are safe standard library routines. Their results do not require disclose()
 * even when derived from witness data, under the assumption that the rand
 * argument is sufficiently random.
 *
 * Official:
 *   https://docs.midnight.network/compact/reference/explicit-disclosure
 *     "The compiler recognizes that certain Compact standard library routines
 *      sufficiently disguise witness data so that explicit declaration of
 *      disclosure is not required. For example, the commitment functions
 *      transientCommit and persistentCommit are both recognized as such..."
 *   https://docs.midnight.network/compact/smart-contract-security
 *     "The result of a persistentCommit operation does not require disclose()
 *      because the use of a random salt value allows the compiler to consider
 *      the return value as sufficiently private for storage publicly."
 *
 * Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
 *   (broader discussion of disclosure rules; this sample shows the safe-routine case)
 *
 * Language pin: Compact ~0.31.1 / language ~0.23.
 * LOCAL-TRUE. Source only. Not compiled here. Not deployed.
 * This file does not fix the public indexer or node.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version 0.23;

import CompactStandardLibrary;

witness secretValue(): Uint<64>;

export ledger storedCommit: Bytes<32>;

// Official: result of persistentCommit does not require disclose() for ledger store.
export circuit storeSafeCommit(rand: Bytes<32>): [] {
  storedCommit = persistentCommit(secretValue(), rand);
}

// Same for transientCommit (circuit-efficient, not guaranteed across upgrades).
export circuit checkTransient(rand: Field): Field {
  return transientCommit(secretValue(), rand);
}
