/*
 * safe-downcast-distinct.compact — keep a guarded unsigned downcast distinct from an unguarded one.
 *
 * Official: Compact toolchain 0.31.1 fixed common-subexpression matching so a guarded (safe)
 * unsigned downcast and an unguarded one of the same value are no longer treated as the same
 * operation. The safe flag is now part of the comparison and of the hash.
 *   https://docs.midnight.network/relnotes/compact/toolchain-0.31.1
 * Public-network pin remains Compact toolchain 0.31.1 / language ~0.23 / compact-runtime 0.16.0:
 *   https://docs.midnight.network/relnotes/support-matrix
 *
 * This file does not invent a new API. It shows an explicit assert before a downcast so the
 * circuit can still reject an out-of-range value even if a generated constraint is missing.
 * Not compiled here. Not a deploy. Not a public indexer or node fix.
 *
 * Upstream: https://github.com/midnightntwrk/midnight-docs/issues/1564 (runtime/reference skew)
 * and the 0.31.1 toolchain notes above.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger stored: Uint<8>;

export circuit storeGuarded(value: Uint<64>): [] {
  assert(value <= 255, "value does not fit Uint<8>");
  stored = disclose(value as Uint<8>);
}
