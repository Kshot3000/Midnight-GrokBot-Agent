/*
 * safe-downcast.compact — keep a bound assert distinct from the Uint cast.
 *
 * Official Compact 0.31.1 notes say common-subexpression matching treated a
 * guarded unsigned downcast and an unguarded one of the same value as the
 * same operation, so one could be substituted for the other. The safe flag
 * is now part of the comparison and of the hash.
 *   https://docs.midnight.network/relnotes/compact/toolchain-0.31.1
 * Public-network pin remains Compact toolchain 0.31.1 / language ~0.23:
 *   https://docs.midnight.network/relnotes/support-matrix
 * The 0.31.0 notes still say downcasts inside a conditional can enlarge the
 * circuit, and that both branches are considered during proof construction:
 *   https://docs.midnight.network/relnotes/compact/toolchain-0.31.0
 * This file does not invent a compiler flag. The assert stays outside the
 * if, and the cast stays a disclose write. Not compiled here. Not a deploy.
 * Not a public indexer or node fix.
 *
 * Upstream: https://github.com/midnightntwrk/midnight-docs/issues/1245
 * (EffectStream guide still tells readers to run compact update 0.31.0.)
 *
 * Built by @kshot9000 https://x.com/kshot9000
Email: kshot9000@gmail.com
Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger stored: Uint<8>;

export circuit storeByte(value: Uint<64>, take: Boolean): [] {
  assert(value <= 255, "value does not fit Uint<8>");
  if (take) {
    stored = disclose(value as Uint<8>);
  }
}
