pragma language_version >= 0.23;

import CompactStandardLibrary;

export sealed ledger organizer: Bytes<32>;

witness secretKey(): Bytes<32>;

circuit deriveOrganizer(sk: Bytes<32>): Bytes<32> {
  persistentHash<Vector<2, Bytes<32>>>([pad(32, "sealed-organizer:pk:"), sk]);
}

constructor() {
  organizer = disclose(deriveOrganizer(secretKey()));
}

export circuit openRound(): [] {
  const pk = deriveOrganizer(secretKey());
  assert(organizer == pk, "You are not the organizer");
}
