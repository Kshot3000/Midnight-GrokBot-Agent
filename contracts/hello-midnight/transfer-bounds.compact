pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger balance: Uint<64>;
export ledger recipient: Bytes<32>;

// Bounds live inside the circuit. No top-level const. No Bytes<32>{}.
export circuit transfer(nextRecipient: Bytes<32>, amount: Uint<64>): [] {
  assert(amount >= 1, "Amount too small");
  assert(amount <= 1000000, "Amount exceeds maximum");
  assert(balance >= amount, "Insufficient funds");
  recipient = disclose(nextRecipient);
  balance = disclose(balance - amount);
}
