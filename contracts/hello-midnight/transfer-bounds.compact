/*
 * transfer-bounds.compact — Compact sample for bounds and empty-recipient asserts.
 *
 * Upstream: midnightntwrk/midnight-docs#1487 (test-and-debug page samples do not
 * compile or run on the pinned stack).
 *
 * Official:
 *   https://docs.midnight.network/compact/test-and-debug
 *   https://docs.midnight.network/guides/compact-javascript-runtime
 *   https://docs.midnight.network/compact/reference/compact-reference
 *
 * The test-and-debug page shows a transfer circuit with top-level const and
 * Bytes<32>{}. Those are rejected by Compact ~0.31.1 / language ~0.23.
 * This sample uses inline bounds and pad(32, "") for the empty check, matching
 * patterns already used in this lab's hello-midnight contracts.
 *
 * Pins: Compact ~0.31.1 / language ~0.23, midnight-js 4.1.1, DApp Connector 4.0.1,
 * proof-server 8.1.0.
 *
 * LOCAL-TRUE. No on-chain deploy is claimed. Does not claim a fix of the public
 * docs site, indexer, or node.
 */

pragma language_version 0.23;
import CompactStandardLibrary;

export ledger balance: Uint<64>;

export circuit transfer(recipient: Bytes<32>, amount: Uint<64>): [] {
  assert(amount >= 1, "Amount too small");
  assert(amount <= 1000000, "Amount exceeds maximum");
  assert(balance >= amount, "Insufficient funds");
  assert(recipient != pad(32, ""), "Invalid recipient");
  balance = balance - amount;
}

