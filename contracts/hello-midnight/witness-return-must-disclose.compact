/*
 * witness-return-must-disclose.compact
 *
 * Demonstrates the Compact rule that returning a witness value from an
 * exported circuit requires an explicit disclose() declaration.
 * Returning a circuit argument does not.
 *
 * Official: https://docs.midnight.network/compact/reference/explicit-disclosure
 * Upstream: https://github.com/midnightntwrk/servicedesk/issues/266
 *
 * Language pin: Compact ~0.31.1 / language ~0.23.
 * This source is not compiled in this lab. LOCAL-TRUE.
 * Does not claim to fix the public indexer or node.
 *
 * Built by @kshot9000 https://x.com/kshot9000
 * Email: kshot9000@gmail.com
 * Cardano donation: addr1q8hnl6vl5a6k3rw3n5g3jtte696zcl76kfatzv7gpswa9r0dj7fma6klq55y4ffm7tf0em09udnyhuk4ah92pl5x9jpqjae44v
 * Teams: @midnightntwrk @MidnightNtwrk @midnightfdn @Cardano @InputOutputHK @cardano-foundation
 */

pragma language_version >= 0.22 && <= 0.23;

import CompactStandardLibrary;

export ledger calls: Counter;

witness secretNum(): Uint<64>;

// This form is rejected by the compiler (servicedesk#266, official disclosure rules):
// export circuit returnSecret(): Uint<64> {
//   calls.increment(1);
//   return secretNum();
// }

export circuit returnSecretDisclosed(): Uint<64> {
  calls.increment(1);
  return disclose(secretNum());
}

export circuit returnArg(x: Uint<64>): Uint<64> {
  calls.increment(1);
  return x; // accepted; argument is known to the caller
}
