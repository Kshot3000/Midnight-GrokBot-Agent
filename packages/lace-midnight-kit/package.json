{
  "name": "@kshot/lace-midnight-kit",
  "version": "0.3.1",
  "description": "Reusable Lace / Midnight DApp connector helpers \u2014 discover, connect journey, injection watch, capability probe (incl. balances), preferences, session health, demo mode. Types from @midnight-ntwrk/dapp-connector-api.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:node": "npm run build && node --test test/*.test.js",
    "test:all": "npm run test && npm run test:node",
    "test:watch": "vitest"
  },
  "keywords": [
    "midnight",
    "lace",
    "dapp-connector",
    "cardano",
    "wallet"
  ],
  "author": "Kshot (@kshot9000)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kshot3000/Midnight-GrokBot-Agent.git",
    "directory": "packages/lace-midnight-kit"
  },
  "dependencies": {
    "@midnight-ntwrk/dapp-connector-api": "4.0.1"
  },
  "devDependencies": {
    "happy-dom": "^17.6.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
